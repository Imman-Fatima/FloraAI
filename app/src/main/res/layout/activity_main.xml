<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">
        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:src="@drawable/floraai_logo"
            android:contentDescription="FloraAI Logo"
            android:scaleType="fitCenter"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FloraAI"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginTop="25dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discover the Beauty of Flowers"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginTop="8dp"/>

        <ImageView
            android:id="@+id/flowerImage"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="28dp"
            android:scaleType="centerCrop"
            android:background="#EAF6FF"
            android:contentDescription="Selected flower image"/>

        <Button
            android:id="@+id/selectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Flower Image"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1565C0"/>

        <Button
            android:id="@+id/predictButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recognize Flower"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1565C0"/>

        <!-- Flower Information Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLOWER IDENTIFICATION"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your flower details will appear here after identification."
                android:textSize="16sp"
                android:textColor="#263238"
                android:gravity="start"
                android:lineSpacingExtra="6dp"
                android:paddingTop="16dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Identification History"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1976D2"/>

    </LinearLayout>

</ScrollView>
